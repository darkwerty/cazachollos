# Copia este fichero a .env. Tal cual, sirve para la demo: reproduce replay_data.jsonl sin Telegram.

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=cazachollos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ingesta: REPLAY (fichero JSONL, sin credenciales), WEB (canales públicos, sin cuenta) o LIVE (grupos con tu cuenta)
INGESTION_MODE=REPLAY
REPLAY_SOURCE_FILE=replay_data.jsonl
REPLAY_SPEED_FACTOR=10.0

# Telegram (solo LIVE y el bot). API_ID y API_HASH, de https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=cazachollos_ingestor
# Grupos que se escuchan, por id o por nombre, separados por comas. Vacío: todos los chats de la cuenta
TELEGRAM_ALLOWED_GROUPS=
# Token del bot, de @BotFather
BOT_TOKEN=

# LLM (opcional). Sin clave, solo reglas fijas
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LOG_LEVEL=INFO

# Modo WEB: canales públicos, separados por comas (nombre o enlace t.me)
TELEGRAM_PUBLIC_CHANNELS=
# Horas activas en hora de Madrid para las pasadas programadas (vacío: siempre)
ACTIVE_HOURS=
# IA: azure, gemini o none
LLM_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
LLM_MAX_CALLS_PER_DAY=200
